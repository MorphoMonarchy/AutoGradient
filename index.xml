    <reapack
      name="AutoGradient"
      type="script"
      desc="Automatic track color gradients using name rules">
      <metadata>
        <description><![CDATA[
AutoGradient watches track names and applies ordered, case-insensitive color
rules. Matching groups receive scalable light-to-dark gradients in track-list
order. AutoGradientConfig provides a ReaImGui editor and color picker.
        ]]></description>
