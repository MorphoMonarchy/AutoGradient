<index version="1" name="AutoGradient">
  <category name="AutoGradient">
    <reapack
      name="AutoGradient"
      type="script"
      desc="Automatic track color gradients and icons using name rules">
      <metadata>
        <description><![CDATA[
AutoGradient watches track names and applies ordered, case-insensitive color
rules. Matching groups receive scalable light-to-dark gradients in track-list
order. Rules may also assign REAPER track icons. AutoGradientConfig provides
a ReaImGui color picker and searchable icon browser.
        ]]></description>
        <link rel="website">https://github.com/MorphoMonarchy/AutoGradient</link>
      </metadata>
